ifneq ($(shell grep -Eq "put_seccomp_filter" $(KSU_SRCTREE)/kernel/seccomp.c $(KSU_SRCTREE)/include/linux/seccomp.h; echo $$?),0)
ifeq ($(shell grep -Eq "seccomp_filter_release" $(KSU_SRCTREE)/kernel/seccomp.c $(KSU_SRCTREE)/include/linux/seccomp.h; echo $$?),0)
