ifeq ($(shell grep -Eq "security_inode_init_security_anon" $(KSU_SRCTREE)/include/linux/security.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_INIT_SEC_ANON
subdir-ccflags-y += -DKSU_COMPAT_HAS_INIT_SEC_ANON
endif

# Checks Samsung
ifeq ($(shell grep -Eq "CONFIG_KDP_CRED" $(KSU_SRCTREE)/kernel/cred.c; echo $$?),0)
ccflags-y += -DSAMSUNG_UH_DRIVER_EXIST
subdir-ccflags-y += -DSAMSUNG_UH_DRIVER_EXIST
